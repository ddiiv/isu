{
  "name": "@isu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "admin:crear": "node --env-file-if-exists=../../.env dist/cli/crear-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/under-pressure": "^9.2.0",
    "@isu/almacen": "workspace:*",
    "@isu/db": "workspace:*",
    "@isu/envios": "workspace:*",
    "@isu/shared": "workspace:*",
    "@isu/stocker": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.9",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "0.8.3",
    "ioredis": "^5.11.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
