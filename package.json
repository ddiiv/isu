{
  "name": "isuwaya-tienda",
  "private": true,
  "description": "Tienda minorista de ISUWAYA: storefront, API, backoffice y workers. Stock y precios salen de Stocker.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm paquetes && pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrar": "pnpm paquetes && pnpm --filter @isu/db migrar",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "seguridad": "node tests/seguridad/auditoria.mjs",
    "verificar": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "paquetes": "pnpm --filter @isu/shared --filter @isu/db build",
    "postinstall": "pnpm paquetes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^16.4.0",
    "pg": "^8.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
