{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @isu/worker... build",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @isu/worker start",
    "restartPolicyType": "ALWAYS"
  }
}
