{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @isu/web... build",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @isu/web start",
    "healthcheckPath": "/robots.txt",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 2
  }
}
