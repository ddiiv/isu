# ── API (apps/api) ───────────────────────────────────────────────────
# La MISMA base de Stocker (en Railway: ${{Postgres.DATABASE_URL}}). La tienda
# sólo usa su esquema `tienda`; ver infra/sql/rol-tienda.sql para darle un
# usuario propio sin permisos sobre las tablas de Stocker.
# Local (docker compose de infra/): así como está.
# Producción: postgres://tienda_app:<clave>@<host de Stocker>:<puerto>/<base de Stocker>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocker
DB_SSL=false
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
ORIGENES_PERMITIDOS=http://localhost:3000,http://localhost:3001
# Cloudflare + borde de Railway = 2. En local, 0.
PROXIES_DE_CONFIANZA=0
LIMITE_PEDIDOS_POR_MINUTO=300
CACHE_SEGUNDOS=30
HOST=::
PORT=4000
# Etapa 1: red privada de Railway + credencial de integración emitida desde el backoffice de Stocker
# STOCKER_API_URL=http://backend.railway.internal:3000/api
# STOCKER_TOKEN=

# ── Tienda (apps/web) ────────────────────────────────────────────────
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
# Completar antes de producción (se muestran en las páginas legales):
NEXT_PUBLIC_RAZON_SOCIAL=
NEXT_PUBLIC_CUIT=
# Dominio del CDN de fotos (R2), separado por comas si hay más de uno:
NEXT_PUBLIC_CDN_IMAGENES=

# Email público de contacto: se edita desde el backoffice (ajuste "email"); valor inicial isu.isuwaya@gmail.com

# ── Worker (apps/worker) ─────────────────────────────────────────────
CONCURRENCIA=5
